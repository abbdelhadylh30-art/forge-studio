{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.forge-studio.app",
  "productName": "Forge Studio",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "electron/dist/**/*",
    "electron/preload.js",
    "package.json",
    "standalone-server/**/*"
  ],
  "extraResources": [
    {
      "from": "public",
      "to": "app/public",
      "filter": ["**/*"]
    },
    {
      "from": "prisma",
      "to": "app/prisma",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": ["portable"],
    "icon": "build/icon.png",
    "artifactName": "ForgeStudio-${version}.${ext}"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "build/icon.png",
    "category": "public.app-category.developer-tools"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "build/icon.png",
    "category": "Development"
  }
}
