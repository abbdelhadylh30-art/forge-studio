{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.forge-studio.app",
  "productName": "Forge Studio",
  "directories": {
    "output": "release",
    "buildResources": "icons"
  },
  "asar": false,
  "files": [
    "electron/dist/**/*",
    "electron/preload.js",
    "package.json",
    "standalone-server/**/*"
  ],
  "extraResources": [
    {
      "from": "public",
      "to": "app/public",
      "filter": ["**/*"]
    },
    {
      "from": "prisma",
      "to": "app/prisma",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "icons/icon.png",
    "artifactName": "ForgeStudio-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "artifactName": "ForgeStudio-Setup-${version}.${ext}"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "icons/icon.png",
    "category": "public.app-category.developer-tools"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "icons/icon.png",
    "category": "Development"
  }
}
