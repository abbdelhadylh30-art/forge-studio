// PixelForge v19 — Prisma schema
// Landing page audit & optimization tool

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  url         String?
  clientName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  audits      Audit[]
  comments    TeamComment[]
  abVariants  ABVariant[]

  @@index([clientName])
}

model Audit {
  id           String   @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String   // "Initial", "After fix X", etc.
  url          String?
  htmlContent  String   // the imported HTML (sanitized)
  score        Int      // 0-100
  desktopScore Int
  mobileScore  Int
  categories   String   // JSON: {seo, content, a11y, structure, perf} {earned, total}
  issues       String   // JSON array of Issue
  isInitial    Boolean  @default(false)
  isSnapshot   Boolean  @default(false)
  createdAt    DateTime @default(now())

  quickFixes   QuickFix[]
  competitorComparisons CompetitorComparison[]

  @@index([projectId])
  @@index([createdAt])
}

model QuickFix {
  id           String   @id @default(cuid())
  auditId      String
  audit        Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  fixId        String   // e.g. "fixAltText", "addMetaDescription"
  issueId      String   // which issue it fixed
  description  String
  beforeValue  String?
  afterValue   String?
  reverted     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([auditId])
}

model CompetitorComparison {
  id              String   @id @default(cuid())
  auditId         String
  audit           Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  competitorUrl   String
  competitorHtml  String
  competitorScore Int
  yourScore       Int
  createdAt       DateTime @default(now())

  @@index([auditId])
}

model TeamComment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      String   @default("Anonymous")
  text        String
  selector    String?  // element this comment is anchored to
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model ABVariant {
  id          String   @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variantName String   @default("A")
  htmlContent String
  score       Int?
  isWinner    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model WhitelabelSetting {
  id            String   @id @default(cuid())
  brandName     String   @default("PixelForge")
  brandColor    String   @default("#5c8def")
  hideBranding  Boolean  @default(false)
  customLogoUrl String?
  updatedAt     DateTime @updatedAt
}

model Client {
  id          String   @id @default(cuid())
  name        String
  email       String?
  company     String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([name])
}

model Feedback {
  id        String   @id @default(cuid())
  message   String
  email     String?
  url       String?  // the page URL where the user was when they submitted
  view      String?  // "dashboard" | "builder" | "auditor" | "templates"
  rating    Int?     // optional 1-5
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model EmailReportRequest {
  id          String   @id @default(cuid())
  email       String
  projectName String
  score       Int
  desktopScore Int
  mobileScore Int
  issueCount  Int
  fixCount    Int
  reportJson  String   // full audit report as JSON string
  sent        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([sent])
}

// ─────────────────────────────────────────────────────────────────────────────
// landing-forge Sites module (ported from abbdelhadylh30-art/landing-forge)
// "Sites" = published landing pages with analytics / A/B / leads / deploys.
// Prefixed Site* to avoid colliding with the auditor's Project/Audit models.
// ─────────────────────────────────────────────────────────────────────────────

model Site {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  config    String // JSON-serialized LandingConfig
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  views    SiteView[]
  events   SiteEvent[]
  deploys  SiteDeploy[]
  leads    SiteLead[]
}

model SiteView {
  id         String   @id @default(cuid())
  projectId  String
  project    Site     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitorId  String   @default("anon") // pseudo-anonymous visitor id (client-generated)
  path       String   @default("/")
  referrer   String   @default("direct")
  country    String   @default("US")
  device     String   @default("desktop")
  browser    String   @default("Chrome")
  variant    String? // PRIMARY A/B variant this visit was exposed to (per-variant duration/engagement)
  variantMap String? // JSON: sectionId → variant name for EVERY enabled section-level test
  duration   Int      @default(0) // seconds in page
  isBounce   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

model SiteEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Site     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // cta_click | form_submit | section_view | variant_exposure | promote_winner
  label     String   @default("")
  variant   String? // A/B variant name, e.g. "A"
  value     Float    @default(0)
  path      String   @default("/")
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model SiteDeploy {
  id         String   @id @default(cuid())
  projectId  String
  project    Site     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status     String   @default("queued") // queued | building | live | failed
  url        String?
  logs       String   @default("[]") // JSON array of {t, msg, level}
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())
}

model SiteLead {
  id        String   @id @default(cuid())
  projectId String
  project   Site     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String   @default("")
  email     String   @default("")
  message   String   @default("")
  fields    String   @default("{}") // JSON map of all submitted field label → value
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}
